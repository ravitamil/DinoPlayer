<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout android:id="@+id/exo_controls_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#22000000" />

    <LinearLayout android:id="@+id/player_top_bar" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_gravity="top" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <ImageButton android:id="@+id/button_back" style="@style/PlayerAction"
            android:src="@drawable/ic_arrow_back_white_24dp" android:contentDescription="@string/back_to_library" />
        <TextView android:id="@+id/player_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="16sp" android:textColor="@color/white"
            android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/button_cancel_captions" style="@style/PlayerAction"
            android:src="@drawable/ic_caption_cancel" android:contentDescription="@string/cancel_caption_job" android:visibility="gone" />
        <ImageButton android:id="@+id/button_subtitle" style="@style/PlayerAction"
            android:src="@drawable/ic_subtitles_24dp" android:contentDescription="@string/subtitle_options" />
        <ImageButton android:id="@+id/exo_settings" style="@style/PlayerAction"
            android:src="@drawable/ic_settings_24dp" android:contentDescription="@string/playback_settings" />
    </LinearLayout>

    <LinearLayout android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content" android:layout_height="56dp"
        android:layout_gravity="center" android:gravity="center" android:layoutDirection="ltr">
        <ImageButton android:id="@+id/exo_prev" style="@style/PlayerAction"
            android:layout_marginEnd="24dp" android:src="@drawable/ic_skip_previous_24dp"
            android:contentDescription="@string/previous_video" />
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
            <ImageButton android:id="@+id/exo_play_pause" style="@style/PlayerAction"
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_play_arrow_48dp" android:contentDescription="@string/play_pause" />
            <ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
        <ImageButton android:id="@+id/exo_next" style="@style/PlayerAction"
            android:layout_marginStart="24dp" android:src="@drawable/ic_skip_next_24dp"
            android:contentDescription="@string/next_video" />
    </LinearLayout>

    <LinearLayout android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:layoutDirection="ltr"
        android:background="@drawable/player_bottom_gradient">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
            <!-- ExoPlayer measures exo_time to decide compact mode. It must wrap the labels, not the seek bar. -->
            <LinearLayout android:id="@+id/exo_time"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/exo_position" style="@style/PlayerTime" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" / " android:textColor="#B3FFFFFF" android:importantForAccessibility="no" />
                <TextView android:id="@+id/exo_duration" style="@style/PlayerTime"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:focusable="true" android:minHeight="48dp" android:gravity="center" />
            </LinearLayout>
            <com.brouken.player.CustomDefaultTimeBar android:id="@+id/exo_progress"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                app:bar_height="3dp" app:touch_target_height="48dp" app:played_color="@color/player_accent"
                app:scrubber_color="#FFFFFF" app:buffered_color="#55FFFFFF" app:unplayed_color="#33FFFFFF" />
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center">
                <ImageButton android:id="@+id/button_lock" style="@style/PlayerAction"
                    android:src="@drawable/ic_lock_open_24dp" android:contentDescription="@string/lock_screen" />
                <ImageButton android:id="@+id/button_aspect_ratio" style="@style/PlayerAction"
                    android:src="@drawable/ic_aspect_ratio_24dp" android:contentDescription="@string/aspect_ratio" />
                <ImageButton android:id="@+id/button_rotate" style="@style/PlayerAction"
                    android:src="@drawable/ic_auto_rotate_24dp" android:contentDescription="@string/rotate_video" />
                <ImageButton android:id="@+id/button_pip" style="@style/PlayerAction"
                    android:src="@drawable/ic_picture_in_picture_alt_24dp" android:contentDescription="@string/picture_in_picture" />


                <ImageButton android:id="@+id/button_open" style="@style/PlayerAction" android:visibility="gone"
                    android:src="@drawable/ic_folder_open_24dp" android:contentDescription="@string/back_to_library" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/exo_minimal_controls"
        android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="bottom|end"
        android:visibility="gone">
        <ImageButton android:id="@+id/button_minimal_play" style="@style/PlayerAction"
            android:src="@drawable/ic_play_arrow_24dp" android:contentDescription="@string/play_pause" />
    </LinearLayout>
</merge>
