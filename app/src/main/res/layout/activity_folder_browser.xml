<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        app:elevation="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextAppearance="@style/TextAppearance.JustPlayer.Toolbar"
            android:background="@color/app_background"
            app:title="@string/your_videos"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="@color/app_text_secondary"
            app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_border" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="20dp"
                android:scrollbars="vertical" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.brouken.player.LibrarySkeletonView
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Modern Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_folder_accent_48dp"
                    app:tint="@color/green" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/no_videos_found"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/text_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="280dp"
                android:text="@string/no_videos_hint"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_empty_change_folder"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/change_folder"
                app:backgroundTint="@color/green"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <!-- Modern Onboarding / First Run Container -->
        <LinearLayout
            android:id="@+id/layout_onboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="44dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_video_library_48dp"
                    app:tint="@color/green" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/onboarding_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:text="@string/onboarding_desc"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_select_folder"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/select_folder"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/green"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_folder_open_24dp"
                app:iconTint="@color/black" />

            <CheckBox
                android:id="@+id/check_include_hidden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:buttonTint="@color/green"
                android:text="@string/show_hidden_folders"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
