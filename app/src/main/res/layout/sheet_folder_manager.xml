<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingBottom="24dp">

    <!-- Material 3 Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/drag_handle_background" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:id="@+id/container_sheet_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/m3_icon_container_background">

            <ImageView
                android:id="@+id/image_sheet_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder_24dp"
                app:tint="@color/green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/text_sheet_folder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:text="Included Folders" />

            <TextView
                android:id="@+id/text_sheet_folder_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:text="Check folders to scan in your video library" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border"
        android:alpha="0.4"
        android:layout_marginBottom="8dp" />

    <!-- Content area: Empty state or List with fixed comfortable viewport -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <LinearLayout
            android:id="@+id/container_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_folder_open_24dp"
                app:tint="@color/app_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/app_text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:text="No folders in list" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:text="Tap '+ Add folder' below to add a folder from storage" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_sheet_folders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="8dp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border"
        android:alpha="0.4"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Pinned Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_folder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Add folder"
            android:textColor="@color/green"
            app:icon="@drawable/ic_add_24dp"
            app:iconTint="@color/green"
            app:strokeColor="@color/green"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_apply_folders"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Apply changes"
            android:textColor="@color/black"
            android:backgroundTint="@color/green"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
